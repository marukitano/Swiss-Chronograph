{
  "name": "Tap Timer",
  "author": "marukitano",
  "version": "1.0.0",
  "keywords": [
    "pebble-app",
    "timer",
    "countdown",
    "smartwatch",
    "pebble-time-2"
  ],
  "private": true,
  "dependencies": {
    "@rebble/clay": "^1.0.8"
  },
  "pebble": {
    "displayName": "Tap Timer",
    "uuid": "92860832-e162-49d5-bd89-81c92c0fe40c",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "emery"
    ],
    "watchapp": {
      "watchface": false
    },
    "messageKeys": [
      "themeMode",
      "ringColorRemaining",
      "alarmVibePattern",
      "audioVolume",
      "showCentiseconds"
    ],
    "resources": {
      "media": [
        {
          "file": "images/app_icon.png",
          "type": "bitmap",
          "name": "APP_ICON",
          "targetPlatforms": [
            "emery"
          ]
        },
        {
          "type": "bitmap",
          "name": "ICON_START",
          "file": "images/action_bar_start.png"
        },
        {
          "type": "bitmap",
          "name": "ICON_TICK",
          "file": "images/action_bar_check.png"
        },
        {
          "type": "bitmap",
          "name": "ALARM",
          "file": "images/status_alarm.png"
        },
        {
          "type": "bitmap",
          "name": "ALERT",
          "file": "images/status_alert.png"
        },
        {
          "type": "bitmap",
          "name": "PAUSE",
          "file": "images/status_pause.png"
        },
        {
          "type": "raw",
          "name": "ALARM_PCM",
          "file": "sounds/alarm.pcm"
        },
        {
          "type": "bitmap",
          "name": "PPF_DIGITS",
          "file": "font/ppf-digits.png"
        },
        {
          "type": "bitmap",
          "name": "PPF_DIGITS_WHITE",
          "file": "font/ppf-digits-white.png"
        }
      ]
    }
  },
  "description": "A tactile countdown timer exclusively for Pebble Time 2, with a magnetic touch ruler and custom pixel display.",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/marukitano/Tap-timer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marukitano/Tap-timer.git"
  },
  "bugs": {
    "url": "https://github.com/marukitano/Tap-timer/issues"
  }
}
